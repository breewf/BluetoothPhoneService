<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 演示层使用传统 View + XML，主题来自 Material Components。 -->
    <style name="Theme.BluetoothPhoneService" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 统一卡片外观，避免每个布局重复属性。 -->
    <style name="Widget.BluetoothPhone.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/app_outline</item>
    </style>

</resources>
