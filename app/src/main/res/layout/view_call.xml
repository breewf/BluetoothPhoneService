<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.BluetoothPhone.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvCallPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="通话"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/tvNoCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="当前无通话"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/app_text_secondary" />

        <LinearLayout
            android:id="@+id/callsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvConference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="会议通话中"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 会议对方（合并前第二路）的独立计时 -->
        <TextView
            android:id="@+id/tvConferencePeerDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/app_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowIncoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnswer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="接听" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="拒接" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="第二路来电"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnswerWaitingHold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="接听并保持当前" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnswerWaitingEnd"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="接听并挂断当前" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectWaiting"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="拒接第二路" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHangupWaiting"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="只挂断第二路" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHangup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="挂断" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHoldOrSwap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="保持" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMerge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="合并为会议（三方通话）"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHangupHeld"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="挂断保持中的通话"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupHeld"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumeHeld"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="恢复保持中的通话" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHangupHeldOnly"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="挂断保持中的通话" />

        </LinearLayout>

        <!--
            音频切换与静音。
            文案固定不拼接“（当前）”，当前所在端用 selected 状态高亮，
            同时限制单行并放开 minWidth，避免长文案换行或被截断。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioCar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="车机音频"
                android:textColor="@color/audio_button_text"
                app:backgroundTint="@color/audio_button_background"
                app:strokeColor="@color/audio_button_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioPhone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="手机音频"
                android:textColor="@color/audio_button_text"
                app:backgroundTint="@color/audio_button_background"
                app:strokeColor="@color/audio_button_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMicMute"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="静音"
                android:textColor="@color/audio_button_text"
                app:backgroundTint="@color/audio_button_background"
                app:strokeColor="@color/audio_button_stroke" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
